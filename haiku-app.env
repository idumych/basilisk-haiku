# haiku-app.env — what the beos-app-platforms release tools need to know about Basilisk.
# Shell syntax: sourced by packaging/haiku/build-hpkg.sh and the release scripts
# (check-artifact.sh, release-gate.sh). Keep values quoted; no spaces around '='.
#
# Basilisk for Haiku is an UNOFFICIAL community port (permission from Basilisk's lead
# developer to use the branding; see release/release-notes-template.md).

# ── Identity ──
APP_NAME="basilisk"                    # the binary / team name (lowercase, as on Linux)
APP_CMD="basilisk"                     # package name and command
APP_SIG="application/x-vnd.Basilisk"   # = resource app_signature in the .rdef
RDEF="basilisk/app/haiku/Basilisk.rdef.in"   # filled in by basilisk/app/Makefile.in

# Haiku only. Basilisk already has its own official Linux builds (and Windows/macOS);
# this repository only adds the Haiku port, so there is no AppImage.
PLATFORMS="haiku"
APP_PATH="apps/Basilisk/basilisk"      # Gecko ships many files next to the binary
DESKBAR_NAME="Basilisk"

# ── Version (= MOZ_APP_VERSION, basilisk/config/version.txt; the .rdef gets it at build) ──
VERSION="52.9.0"
REVISION="1"

# ── Package metadata ──
SUMMARY="Basilisk web browser (unofficial community port)"
DESCRIPTION_FILE="packaging/haiku/description.txt"
HOMEPAGE="https://www.basilisk-browser.org/"
GITHUB_REPO=""                         # not published yet
LICENSE_NAME="MPL v2.0"
COPYRIGHT="Basilisk-Dev and contributors; Mozilla Foundation and contributors"
PACKAGER="Basilisk for Haiku community port"

# Runtime dependencies beyond the Haiku API (HaikuPorts package names; also in
# packaging/haiku/PackageInfo.in). Optional, dlopen()ed: mesa (libOSMesa, WebGL) and
# ffmpeg6/ffmpeg8 (libavcodec, H.264/AAC only), myspell/myspell_<lang> (spell checking).
HPKG_REQUIRES_EXTRA="nspr nss libevent libffi icu74 libvpx fontconfig freetype zlib bzip2 libjpeg_turbo"
DESKTOP_CATEGORIES="Network;WebBrowser;"
APPIMAGE_MUST_BUNDLE=""
APPIMAGE_FONTS_EXTRA=""
APPIMAGE_TRANSLATORS=""
COSMOE_REPO=""
COSMOE_TAG=""
SMOKE_ARGS="about:blank"
SMOKE_WINDOW=""
SMOKE_PROCESS=""
APPIMAGE_EXTRA_FILES=""
APPIMAGE_PREBUILD=""
APPIMAGE_APT_EXTRA=""

# ── Build ──  (see mozconfig-haiku; `./mach build && ./mach package`, then
# packaging/haiku/build-hpkg.sh)
HPKG_BUILD_DEPS="nspr_devel nss_devel libevent_devel libffi_devel icu74_devel libvpx_devel fontconfig_devel freetype_devel zlib_devel bzip2_devel libjpeg_turbo_devel"
TEST_CMD=""                            # no host-side unit tests for the port
TYPECHECK_SRCS=""                      # Gecko is compiled in the VM, not type-checked on the host
TYPECHECK_INCLUDES=""
TYPECHECK_CXXFLAGS=""

# ── Feature test (release/test-plan.md) ──
FEATURE_CHECKS="page-load https form-input shortcuts download single-launch"
EVIDENCE_1="{p}-page-load.txt|Basilisk test page {p}"
EVIDENCE_2="{p}-https.txt|Example Domain"
EVIDENCE_3="{p}-form.log|q=hello\+from\+{p}"
EVIDENCE_4="{p}-shortcuts.txt|PASS new-tab PASS close-tab PASS find"
EVIDENCE_5="{p}-download.txt|BEOS:TYPE.*application/zip"
EVIDENCE_6="{p}-single-launch.txt|teams=1"
