name			basilisk
version			@VERSION@-@REVISION@
architecture		x86_64
summary			"Basilisk web browser (unofficial community port)"
description		"@DESCRIPTION@"
packager		"Basilisk for Haiku community port"
vendor			"Basilisk for Haiku (unofficial community port)"
copyrights		{
	"Basilisk-Dev and contributors"
	"Mozilla Foundation and contributors"
}
licenses		{
	"MPL v2.0"
}
urls			{
	"https://www.basilisk-browser.org/"
}

provides		{
	basilisk = @VERSION@
	app:Basilisk = @VERSION@
}

# Optional, not required (dlopen()ed at run time): mesa (libOSMesa.so.8)
# enables WebGL; ffmpeg6 or ffmpeg8 (lib:libavcodec, so.60/so.62) enables
# H.264/AAC (VP8/VP9/AV1/Opus use the bundled decoders); myspell or
# myspell_<lang> (/boot/system/data/hunspell) enables spell checking. .hpkg has no "recommends", so it is only noted
# in the description.
requires		{
	haiku >= r1~beta6
	nspr
	nss
	libevent
	libffi
	fontconfig
	freetype
	zlib
	libiconv
	libjpeg_turbo
}
