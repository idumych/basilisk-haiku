/*
 * Haiku application resources for the basilisk binary.
 * basilisk/app/Makefile.in fills in the @...@ fields, compiles this with
 * rc and attaches it with xres right after linking (after any strip,
 * since strip drops resources).
 *
 * Basilisk for Haiku is an unofficial community port.
 */

resource app_signature "application/x-vnd.Basilisk";

/* One instance per signature: there is no X11 remoting on Haiku, so an
 * ordinary second launch forwards its arguments to the running instance
 * (B_ARGV_RECEIVED) and exits before touching the profile; dropped files
 * and "Open with" arrive there as B_REFS_RECEIVED. -P/-profile and
 * -no-remote give the new instance its own signature
 * (application/x-vnd.Basilisk-<hash> or a unique one), which
 * B_EXCLUSIVE_LAUNCH lets run next to the default one (B_SINGLE_LAUNCH
 * would refuse it, being one instance per executable). */
resource app_flags B_EXCLUSIVE_LAUNCH;

resource app_version {
	major  = @APP_MAJOR@,
	middle = @APP_MIDDLE@,
	minor  = @APP_MINOR@,

	variety = B_APPV_FINAL,
	internal = 0,

	short_info = "Basilisk @APP_VERSION@",
	long_info = "Basilisk @APP_VERSION@ web browser. Unofficial community port for Haiku."
};

resource file_types message {
	"types" = "text/html",
	"types" = "application/xhtml+xml",
	"types" = "text/xml",
	"types" = "image/svg+xml",
	"types" = "application/x-vnd.Be.URL.http",
	"types" = "application/x-vnd.Be.URL.https",
	"types" = "application/x-vnd.Be.URL.ftp"
};

#include "icon.rdef"
